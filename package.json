{
  "name": "dsh-creator-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Creation-mode switch above the composer: keep the three base modes and compose the creation toolset on top.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host/*.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-agent-preset"
      ]
    }
  }
}
