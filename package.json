{
  "name": "zcode-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dynamic workflows: the model writes a workflow script that orchestrates many subagents in parallel.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client-src/*.js",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "locale/ui/*.json",
    "icon.svg",
    "host/*.js",
    "skills/*.md",
    "docs/*.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
